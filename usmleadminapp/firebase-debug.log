","entryPoint":"onCustomerDataDeleted","timeout":"60s","availableMemoryMb":256,"serviceAccountEmail":"ext-firestore-stripe-subs-8fe5@usmlesarthi-residency-match.iam.gserviceaccount.com","updateTime":"2021-06-25T13:17:58.860Z","versionId":"2","labels":{"goog-dm":"firebase-ext-firestore-stripe-subscriptions","goog-firebase-ext":"firestore-stripe-subscriptions","deployment-tool":"firebase-extensions","goog-firebase-ext-iid":"firestore-stripe-subscriptions"},"environmentVariables":{"CUSTOMERS_COLLECTION":"customers","DATABASE_INSTANCE":"usmlesarthi-residency-match","DATABASE_URL":"https://usmlesarthi-residency-match.firebaseio.com","DELETE_STRIPE_CUSTOMERS":"Do not delete","EXT_INSTANCE_ID":"firestore-stripe-subscriptions","FIREBASE_CONFIG":"{\"projectId\":\"usmlesarthi-residency-match\",\"databaseURL\":\"https://usmlesarthi-residency-match.firebaseio.com\",\"storageBucket\":\"usmlesarthi-residency-match.appspot.com\"}","LOCATION":"us-central1","PRODUCTS_COLLECTION":"products","PROJECT_ID":"usmlesarthi-residency-match","STORAGE_BUCKET":"usmlesarthi-residency-match.appspot.com","STRIPE_API_KEY":"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","STRIPE_WEBHOOK_SECRET":"whsec_gvntytoUhk35tM3iQJJc4fUO3kS52bKN","SYNC_USERS_ON_CREATE":"Do not sync"},"runtime":"nodejs10","maxInstances":3000,"ingressSettings":"ALLOW_ALL","buildId":"f18c5ed3-5f91-4f49-b9ff-64fe8cd7a9f6","buildName":"projects/461306056844/locations/us-central1/builds/f18c5ed3-5f91-4f49-b9ff-64fe8cd7a9f6","dockerRegistry":"CONTAINER_REGISTRY","satisfiesPzi":true},{"name":"projects/usmlesarthi-residency-match/locations/us-central1/functions/ext-delete-user-data-clearData","description":"Listens for user accounts to be deleted from your project's authenticated users, then removes any associated user data (based on Firebase Authentication's User ID) from Realtime Database, Cloud Firestore, and/or Cloud Storage.","sourceArchiveUrl":"gs://firebase-mod-sources-