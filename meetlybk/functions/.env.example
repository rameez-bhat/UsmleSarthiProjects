FUNCTIONS_REGION=asia-south1
APP_ORIGIN=https://YOUR-SCHEDULER-SITE.web.app
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
# OAuth redirect is https://REGION-PROJECT.cloudfunctions.net/schedulerOAuthCallback
OAUTH_REDIRECT_URI=
# Enable only after adding App Check to your Firebase web app.
ENFORCE_APP_CHECK=false
# Meeting emails use your existing default database mail collection.
# No EMAIL_ENABLED flag or new SMTP configuration is needed.

# Optional Zoom Server-to-Server OAuth (hosts must belong to this Zoom account).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
# Store ZOOM_CLIENT_SECRET in Secret Manager, never here or in VITE_* values.
# Optional in-app video. Configure your Jitsi server's HTTPS origin.
JITSI_SERVER_URL=
# For token-authenticated self-hosted Jitsi; store JITSI_JWT_SECRET as a secret.
JITSI_JWT_APP_ID=

# Optional personal Zoom OAuth (separate from existing Server-to-Server app)
ZOOM_OAUTH_CLIENT_ID=
# Store ZOOM_OAUTH_CLIENT_SECRET in Secret Manager, never in this file.
