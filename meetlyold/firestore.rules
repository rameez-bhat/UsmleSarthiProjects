rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  match /scheduler_hosts/{uid} { allow read: if owner(uid); allow write: if false; }
  match /scheduler_events/{id} { allow read: if owner(resource.data.ownerId); allow write: if false; }
  match /scheduler_bookings/{id} { allow read: if owner(resource.data.ownerId); allow write: if false; }
  match /scheduler_connections/{id} { allow read: if owner(resource.data.ownerId); allow write: if false; }
  // Private tokens, OAuth states, rate limits, jobs, slot locks and email are server-only.
  match /{document=**} { allow read, write: if false; }
 }
}
